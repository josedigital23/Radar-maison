{
  "manifest_version": 2,
  "name": "Radar Maison",
  "version": "2.0",
  "description": "Retrouve l'adresse exacte d'un bien immobilier à partir de son annonce, via la base DPE de l'ADEME.",
  "browser_specific_settings": {
    "gecko": {
      "id": "radar-maison@local"
    }
  },
  "permissions": [
    "https://data.ademe.fr/*",
    "https://api-adresse.data.gouv.fr/*",
    "https://files.data.gouv.fr/*",
    "https://*.data.gouv.fr/*",
    "https://apicarto.ign.fr/*",
    "https://data.geopf.fr/*",
    "https://www.georisques.gouv.fr/*",
    "https://mapsref.brgm.fr/*",
    "https://recherche-entreprises.api.gouv.fr/*",
    "https://data.education.gouv.fr/*",
    "https://data.economie.gouv.fr/*",
    "https://hubeau.eaufrance.fr/*",
    "storage"
  ],
  "background": {
    "scripts": [
      "background.js"
    ]
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "moteur/collecte.js",
        "moteur/notation.js",
        "moteur/regles.js",
        "rapport.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "browser_action": {
    "default_title": "Radar Maison — retrouver l'adresse",
    "default_icon": {
      "16": "icones/16.png",
      "32": "icones/32.png",
      "48": "icones/48.png"
    }
  },
  "icons": {
    "48": "icones/48.png",
    "128": "icones/128.png"
  },
  "web_accessible_resources": [
    "montserrat.woff2"
  ]
}