{
  "manifest_version": 2,
  "name": "Radar Maison",
  "version": "1.15",
  "description": "Retrouve l'adresse exacte d'un bien immobilier à partir de son annonce, via la base DPE de l'ADEME.",
  "browser_specific_settings": {
    "gecko": {
      "id": "radar-maison@local"
    }
  },
  "permissions": [
    "https://data.ademe.fr/*",
    "https://api-adresse.data.gouv.fr/*",
    "https://files.data.gouv.fr/*"
  ],
  "background": {
    "scripts": [
      "background.js"
    ]
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "browser_action": {
    "default_title": "Radar Maison — retrouver l'adresse",
    "default_icon": {
      "16": "icones/16.png",
      "32": "icones/32.png",
      "48": "icones/48.png"
    }
  },
  "icons": {
    "48": "icones/48.png",
    "128": "icones/128.png"
  }
}
